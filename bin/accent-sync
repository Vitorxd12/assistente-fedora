#!/usr/bin/env bash
# Sincroniza a cor de destaque do GNOME com o kitty e o prompt do zsh.
apply() {
  local name hex fg
  name=$(gsettings get org.gnome.desktop.interface accent-color 2>/dev/null | tr -d "'")
  case "$name" in
    blue)   hex='#3584e4' ;;  teal)   hex='#2190a4' ;;
    green)  hex='#3a944a' ;;  yellow) hex='#c88800' ;;
    orange) hex='#ed5b00' ;;  red)    hex='#e62d42' ;;
    pink)   hex='#d56199' ;;  purple) hex='#9141ac' ;;
    slate)  hex='#6f8396' ;;  *)      hex='#3584e4' ;;
  esac
  fg='#ffffff'; [[ $name == yellow ]] && fg='#1a1b26'
  printf '%s %s\n' "$hex" "$fg" > ~/.cache/accent-color
  cat > ~/.config/kitty/accent.conf <<CONF
# gerado por accent-sync — não editar
active_tab_background $hex
active_tab_foreground $fg
cursor $hex
selection_background $hex
selection_foreground $fg
CONF
  pkill -USR1 -x kitty 2>/dev/null || true   # kitty recarrega a config
}
apply
if [[ $1 == --watch ]]; then
  gsettings monitor org.gnome.desktop.interface accent-color | while read -r _; do apply; done
fi
