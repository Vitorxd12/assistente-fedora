#!/usr/bin/python3
"""Remove os hooks antigos de energia do G-Helper e restaura os valores salvos."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import shlex
import sys
import tempfile


def save_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, indent=2)
            stream.write("\n")
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


class Hardware:
    """Access only CPU boost and GNOME idle timeout values saved by old versions."""

    def __init__(self):
        self.paths = {}
        intel = Path("/sys/devices/system/cpu/intel_pstate/no_turbo")
        generic = Path("/sys/devices/system/cpu/cpufreq/boost")
        if intel.exists():
            self.paths["intel-no-turbo"] = intel
        elif generic.exists():
            self.paths["cpu-boost"] = generic

    def read(self, keys):
        values = {}
        for key, path in self.paths.items():
            if key not in keys:
                continue
            values[key] = int(path.read_text())
        if "idle-delay" in keys:
            from gi.repository import Gio

            self.session = Gio.Settings.new("org.gnome.desktop.session")
            values["idle-delay"] = self.session.get_uint("idle-delay")
        return values

    def write(self, key, value):
        if key == "idle-delay":
            from gi.repository import Gio

            session = getattr(self, "session", None)
            if session is None:
                session = Gio.Settings.new("org.gnome.desktop.session")
            if not session.set_uint("idle-delay", value):
                raise OSError("preferência de inatividade bloqueada")
            Gio.Settings.sync()
            return
        self.paths[key].write_text(str(value))


def ghelper_running():
    for process in Path("/proc").glob("[0-9]*"):
        try:
            if process.stat().st_uid == os.getuid() and (process / "comm").read_text().strip() == "ghelper":
                return True
        except OSError:
            pass
    return False


def paths():
    home = Path.home()
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
    state_home = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state"))
    return (
        config_home / "ghelper/config.json",
        state_home / "battery-saver",
        shlex.quote(str(home / ".local/bin/battery-saver")) + " --apply",
    )


def read_json(path, default):
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else default


def needs_restore(config_path, state_dir, command):
    config = read_json(config_path, {})
    if any(key.startswith("mode_command_") and value == command for key, value in config.items()):
        return True
    if (state_dir / "preferences.json").exists():
        return True
    session = read_json(state_dir / "session.json", {})
    for bucket in ("restore", "original_ac"):
        if session.get(bucket):
            return True
    return False


def restore_hardware(state, state_path):
    pending = False
    errors = []
    for bucket in ("restore", "original_ac"):
        for key in list(state.get(bucket, {})):
            if key.startswith("screen:"):
                del state[bucket][key]
                pending = True

    keys = {
        key
        for bucket in ("restore", "original_ac")
        for key in state.get(bucket, {})
        if not key.startswith("screen:")
    }
    if keys:
        try:
            hardware = Hardware()
            values = hardware.read(keys)
        except Exception as error:
            errors.append(f"não consegui ler os valores de hardware: {error}")
            values = {}
            hardware = None

        for bucket in ("restore", "original_ac"):
            for key, original in list(state.get(bucket, {}).items()):
                if key.startswith("screen:") or key not in values:
                    continue
                try:
                    if values[key] != original:
                        hardware.write(key, original)
                    values[key] = original
                    del state[bucket][key]
                    pending = True
                except (OSError, ValueError, KeyError) as error:
                    errors.append(f"não consegui restaurar {key}: {error}")

    if pending:
        save_json(state_path, state)
    return errors


def restore_preferences(config_path, state_dir, command):
    errors = []
    backup_path = state_dir / "preferences.json"
    backup = None
    if backup_path.exists():
        try:
            backup = read_json(backup_path, {})
        except (OSError, ValueError) as error:
            errors.append(f"não consegui ler o backup das preferências: {error}")

    if not config_path.exists():
        if backup is not None:
            errors.append("config.json do G-Helper não existe; backup preservado para recuperação manual")
        return errors

    try:
        config = read_json(config_path, {})
        changed = False
        if backup is not None:
            for key, managed_value in backup.get("managed", {}).items():
                if config.get(key) != managed_value:
                    continue
                if key in backup.get("original", {}):
                    config[key] = backup["original"][key]
                else:
                    config.pop(key, None)
                changed = True

        # Sem backup, remove apenas hooks exatamente idênticos aos criados pelo assistente.
        for key, value in list(config.items()):
            if key.startswith("mode_command_") and value == command:
                config.pop(key)
                changed = True

        if changed:
            save_json(config_path, config)
        if backup is not None:
            backup_path.unlink(missing_ok=True)
    except (OSError, ValueError, TypeError) as error:
        errors.append(f"não consegui restaurar config.json do G-Helper: {error}")
    return errors


def restore(config_path, state_dir, command):
    if ghelper_running():
        raise RuntimeError("feche o G-Helper antes de remover os hooks")

    errors = []
    session_path = state_dir / "session.json"
    if session_path.exists():
        lock_path = state_dir / "lock"
        with lock_path.open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                state = read_json(session_path, {})
                errors.extend(restore_hardware(state, session_path))
            except (OSError, ValueError, TypeError) as error:
                errors.append(f"não consegui restaurar os valores de energia salvos: {error}")

    errors.extend(restore_preferences(config_path, state_dir, command))
    return errors


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--restore-check", action="store_true", help="verifica se há automação antiga para remover")
    modes.add_argument("--restore", action="store_true", help="remove os hooks antigos e restaura valores salvos")
    args = parser.parse_args()

    if os.geteuid() == 0:
        raise RuntimeError("execute como seu usuário, sem sudo")

    config_path, state_dir, command = paths()
    if args.restore_check:
        print("yes" if needs_restore(config_path, state_dir, command) else "no")
        return 0

    errors = restore(config_path, state_dir, command)
    if errors:
        for error in errors:
            print(f"battery-saver: {error}", file=sys.stderr)
        return 1
    print("Hooks de energia removidos; preferências e valores salvos restaurados.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError) as error:
        print(f"battery-saver: {error}", file=sys.stderr)
        raise SystemExit(1)
