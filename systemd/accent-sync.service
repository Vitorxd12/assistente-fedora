[Unit]
Description=Sincroniza o wallpaper e a cor de destaque do GNOME com o kitty
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# espera a sessão assentar para não disputar CPU com o GNOME Shell no login
ExecStartPre=/bin/sleep 10
ExecStart=%h/.local/bin/accent-sync --watch
Restart=on-failure

[Install]
WantedBy=graphical-session.target
