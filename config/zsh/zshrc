# ── oh-my-zsh ─────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="lambda-vitor"

plugins=(
  git                 # aliases do git (gst, gco, gp, gl...)
  sudo                # Esc Esc → coloca "sudo" no comando
  extract             # x arquivo.zip/.tar.gz/... → extrai qualquer formato
  colored-man-pages   # man coloridas
  copypath            # copypath → copia a pasta atual
  copyfile            # copyfile arq → copia o conteúdo do arquivo
  dirhistory          # Alt+← / Alt+→ pasta anterior/próxima, Alt+↑ pasta pai
  command-not-found   # sugere o pacote dnf quando o comando não existe
)

# navegação "inteligente": zoxide se instalado, senão o z do oh-my-zsh
if command -v zoxide >/dev/null; then plugins+=(zoxide); else plugins+=(z); fi
command -v fzf >/dev/null && plugins+=(fzf)   # Ctrl+R histórico, Ctrl+T arquivos, Alt+C pastas
command -v eza >/dev/null && plugins+=(eza)

# extras (ordem importa: completions antes, highlighting e substring por último)
[[ -d $ZSH/custom/plugins/zsh-completions ]] && fpath+=$ZSH/custom/plugins/zsh-completions/src
plugins+=(zsh-autosuggestions zsh-syntax-highlighting history-substring-search)

source $ZSH/oh-my-zsh.sh

# ── completar ─────────────────────────────────────────────
zstyle ':completion:*' menu select                              # Tab abre menu navegável
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}           # cores no menu
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'  # ignora maiúsc. e completa no meio
zstyle ':completion:*:descriptions' format '%F{244}── %d ──%f'
setopt complete_in_word always_to_end

# ── autosugestões ─────────────────────────────────────────
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=244"
ZSH_AUTOSUGGEST_STRATEGY=(history completion)                   # histórico + completions
bindkey '^ ' autosuggest-accept                                 # Ctrl+Espaço aceita sugestão
bindkey '^[[1;5C' forward-word                                  # Ctrl+→ aceita palavra por palavra

# ── histórico ─────────────────────────────────────────────
# ↑ / ↓ buscam no histórico pelo que você já digitou
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey "$terminfo[kcuu1]" history-substring-search-up
bindkey "$terminfo[kcud1]" history-substring-search-down
HISTSIZE=100000
SAVEHIST=100000
setopt hist_ignore_all_dups hist_reduce_blanks

# ── aliases ───────────────────────────────────────────────
if ! command -v eza >/dev/null; then
  alias ls='ls --color=auto'
  alias ll='ls -lah --color=auto'
fi
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias md='mkdir -p'
alias reload='exec zsh'
export PATH="$HOME/.local/bin:$PATH"

# ── preview de pastas ao digitar "cd " ───────────────────
# mostra as pastas embaixo enquanto digita (só se couberem na tela); Tab escolhe
lv_cd_preview() {
  if [[ $LBUFFER == cd\ * && -z $RBUFFER ]]; then
    comppostfuncs=(lv_preview_guard)
    zle list-choices 2>/dev/null
  fi
}
# se a lista não couber na tela, não mostra nada (em vez de perguntar
# "do you wish to see all N possibilities?" e engolir a próxima tecla)
lv_preview_guard() {
  if (( compstate[list_lines] + BUFFERLINES + 2 > LINES )); then
    compstate[list]=''
  fi
}
lv_self_insert()   { zle .self-insert;          lv_cd_preview }
lv_backward_del()  { zle .backward-delete-char; lv_cd_preview }
lv_magic_space()   { zle .magic-space;          lv_cd_preview }
zle -N self-insert          lv_self_insert
zle -N backward-delete-char lv_backward_del
zle -N magic-space          lv_magic_space
LISTMAX=0                   # só pergunta "mostrar todas?" se não couber na tela

# ── cd inteligente ────────────────────────────────────────
# Funciona como o cd normal; se a pasta não existir onde você está, pula para
# a pasta mais usada com esse nome (via zoxide, se instalado, ou o z).
#   cd tecsus   → ~/repos/wmsaude/tecsus, de qualquer lugar
cd() {
  # sem argumento, opções (-, -P...), caminhos com / ou pastas que existem → cd normal
  if (( $# != 1 )) || [[ $1 == -* || $1 == */* || -d $1 ]]; then
    builtin cd "$@"; return
  fi
  builtin cd "$1" 2>/dev/null && return          # CDPATH etc.
  local dest
  if command -v zoxide >/dev/null; then
    dest=$(zoxide query -- "$1" 2>/dev/null)
  else
    dest=$(zshz -e "$1" 2>/dev/null)
  fi
  if [[ -n $dest && -d $dest ]]; then
    builtin cd -- "$dest" && print -P "%F{244}→ %~%f"
  else
    print -u2 "cd: pasta não encontrada: $1"; return 1
  fi
}
