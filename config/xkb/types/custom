// Ctrl+Alt como AltGr, preservando Ctrl e Alt usados separadamente.
default partial xkb_types "default" {
    virtual_modifiers Alt, LevelThree;
    type "FOUR_LEVEL" {
	modifiers = Control + Alt + Shift + LevelThree;
	map[None] = Level1;
	map[Shift] = Level2;
	map[LevelThree] = Level3;
	map[Shift+LevelThree] = Level4;
	level_name[Level1] = "Base";
	level_name[Level2] = "Shift";
	level_name[Level3] = "AltGr";
	level_name[Level4] = "Shift AltGr";
        map[Control] = Level1;
        preserve[Control] = Control;
        map[Control+Shift] = Level2;
        preserve[Control+Shift] = Control;
        map[Control+LevelThree] = Level3;
        preserve[Control+LevelThree] = Control;
        map[Control+Shift+LevelThree] = Level4;
        preserve[Control+Shift+LevelThree] = Control;
        map[Alt] = Level1;
        preserve[Alt] = Alt;
        map[Alt+Shift] = Level2;
        preserve[Alt+Shift] = Alt;
        map[Alt+LevelThree] = Level3;
        preserve[Alt+LevelThree] = Alt;
        map[Alt+Shift+LevelThree] = Level4;
        preserve[Alt+Shift+LevelThree] = Alt;
        map[Control+Alt] = Level3;
        map[Control+Alt+Shift] = Level4;
        map[Control+Alt+LevelThree] = Level3;
        map[Control+Alt+Shift+LevelThree] = Level4;
    };
    type "FOUR_LEVEL_ALPHABETIC" {
	modifiers = Control + Alt + Shift + Lock + LevelThree;
	map[None] = Level1;
	map[Shift] = Level2;
	map[Lock] = Level2;
	map[Shift+Lock] = Level1;
	map[LevelThree] = Level3;
	map[Shift+LevelThree] = Level4;
	map[Lock+LevelThree] = Level4;
	map[Shift+Lock+LevelThree] = Level3;
	level_name[Level1] = "Base";
	level_name[Level2] = "Shift";
	level_name[Level3] = "AltGr";
	level_name[Level4] = "Shift AltGr";
        map[Control] = Level1;
        preserve[Control] = Control;
        map[Control+Shift] = Level2;
        preserve[Control+Shift] = Control;
        map[Control+Lock] = Level2;
        preserve[Control+Lock] = Control;
        map[Control+Shift+Lock] = Level1;
        preserve[Control+Shift+Lock] = Control;
        map[Control+LevelThree] = Level3;
        preserve[Control+LevelThree] = Control;
        map[Control+Shift+LevelThree] = Level4;
        preserve[Control+Shift+LevelThree] = Control;
        map[Control+Lock+LevelThree] = Level4;
        preserve[Control+Lock+LevelThree] = Control;
        map[Control+Shift+Lock+LevelThree] = Level3;
        preserve[Control+Shift+Lock+LevelThree] = Control;
        map[Alt] = Level1;
        preserve[Alt] = Alt;
        map[Alt+Shift] = Level2;
        preserve[Alt+Shift] = Alt;
        map[Alt+Lock] = Level2;
        preserve[Alt+Lock] = Alt;
        map[Alt+Shift+Lock] = Level1;
        preserve[Alt+Shift+Lock] = Alt;
        map[Alt+LevelThree] = Level3;
        preserve[Alt+LevelThree] = Alt;
        map[Alt+Shift+LevelThree] = Level4;
        preserve[Alt+Shift+LevelThree] = Alt;
        map[Alt+Lock+LevelThree] = Level4;
        preserve[Alt+Lock+LevelThree] = Alt;
        map[Alt+Shift+Lock+LevelThree] = Level3;
        preserve[Alt+Shift+Lock+LevelThree] = Alt;
        map[Control+Alt] = Level3;
        map[Control+Alt+Shift] = Level4;
        map[Control+Alt+Lock] = Level4;
        map[Control+Alt+Shift+Lock] = Level3;
        map[Control+Alt+LevelThree] = Level3;
        map[Control+Alt+Shift+LevelThree] = Level4;
        map[Control+Alt+Lock+LevelThree] = Level4;
        map[Control+Alt+Shift+Lock+LevelThree] = Level3;
    };
    type "FOUR_LEVEL_SEMIALPHABETIC" {
	modifiers = Control + Alt + Shift + Lock + LevelThree;
	map[None] = Level1;
	map[Shift] = Level2;
	map[Lock] = Level2;
	map[Shift+Lock] = Level1;
	map[LevelThree] = Level3;
	map[Shift+LevelThree] = Level4;
	map[Lock+LevelThree] = Level3;
	map[Shift+Lock+LevelThree] = Level4;
	preserve[Lock+LevelThree] = Lock;
	preserve[Shift+Lock+LevelThree] = Lock;
	level_name[Level1] = "Base";
	level_name[Level2] = "Shift";
	level_name[Level3] = "AltGr";
	level_name[Level4] = "Shift AltGr";
        map[Control] = Level1;
        preserve[Control] = Control;
        map[Control+Shift] = Level2;
        preserve[Control+Shift] = Control;
        map[Control+Lock] = Level2;
        preserve[Control+Lock] = Control;
        map[Control+Shift+Lock] = Level1;
        preserve[Control+Shift+Lock] = Control;
        map[Control+LevelThree] = Level3;
        preserve[Control+LevelThree] = Control;
        map[Control+Shift+LevelThree] = Level4;
        preserve[Control+Shift+LevelThree] = Control;
        map[Control+Lock+LevelThree] = Level3;
        preserve[Control+Lock+LevelThree] = Control;
        map[Control+Shift+Lock+LevelThree] = Level4;
        preserve[Control+Shift+Lock+LevelThree] = Control;
        map[Alt] = Level1;
        preserve[Alt] = Alt;
        map[Alt+Shift] = Level2;
        preserve[Alt+Shift] = Alt;
        map[Alt+Lock] = Level2;
        preserve[Alt+Lock] = Alt;
        map[Alt+Shift+Lock] = Level1;
        preserve[Alt+Shift+Lock] = Alt;
        map[Alt+LevelThree] = Level3;
        preserve[Alt+LevelThree] = Alt;
        map[Alt+Shift+LevelThree] = Level4;
        preserve[Alt+Shift+LevelThree] = Alt;
        map[Alt+Lock+LevelThree] = Level3;
        preserve[Alt+Lock+LevelThree] = Alt;
        map[Alt+Shift+Lock+LevelThree] = Level4;
        preserve[Alt+Shift+Lock+LevelThree] = Alt;
        map[Control+Alt] = Level3;
        map[Control+Alt+Shift] = Level4;
        map[Control+Alt+Lock] = Level3;
        map[Control+Alt+Shift+Lock] = Level4;
        map[Control+Alt+LevelThree] = Level3;
        map[Control+Alt+Shift+LevelThree] = Level4;
        map[Control+Alt+Lock+LevelThree] = Level3;
        map[Control+Alt+Shift+Lock+LevelThree] = Level4;
    };
};
