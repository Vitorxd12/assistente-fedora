[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000000'>, 'params': <{'unscaled_radius': <69>, 'brightness': <0.77000000000000002>}>}>]>}, 'pipeline_liquid_glass': {'name': <'Liquid Glass'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_liquid_glass_luminosity'>, 'params': <{'saturation_multiplicator': <1.1000000000000001>, 'brightness_shift': <-0.55000000000000004>}>}>, <{'type': <'refraction'>, 'id': <'effect_liquid_glass_refraction'>, 'params': <{'tint': <0>, 'blur_radius': <10>, 'edge_size': <12>, 'falloff': <2.3999999999999999>, 'refraction_style': <0.63>, 'gloss': <1>, 'tint_color': <(0.0, 0.0, 0.0, 1.0)>, 'shadow': <0.29999999999999999>, 'rgb_fringing': <0.46000000000000002>, 'texture_repeat': <0>}>}>]>}, 'pipeline_vapor_glass': {'name': <'Vapor Glass'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_vapor_glass_luminosity'>, 'params': <{'saturation_multiplicator': <1.1000000000000001>}>}>, <{'type': <'wave'>, 'id': <'effect_vapor_glass_wave'>, 'params': <@a{sv} {}>}>, <{'type': <'refraction'>, 'id': <'effect_vapor_glass_refraction'>, 'params': <{'tint': <0>}>}>, <{'type': <'noise'>, 'id': <'effect_vapor_glass_noise'>, 'params': <{'noise': <0.10000000000000001>}>}>]>}, 'pipeline_classic_light_background': {'name': <'Classic Light Background'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_classic_light_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_classic_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.25)>, 'blend_mode': <17>}>}>]>}, 'pipeline_classic_dark_background': {'name': <'Classic Dark Background'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_classic_dark_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_classic_dark_color'>, 'params': <{'color': <(0.40000000596046448, 0.40000000596046448, 0.40000000596046448, 0.34999999403953552)>, 'blend_mode': <1>}>}>]>}}

[blur-my-shell/applications]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
pipeline='pipeline_default'

[blur-my-shell/hidetopbar]
compatibility=false

[blur-my-shell/overview]
pipeline='pipeline_liquid_glass'

[blur-my-shell/panel]
blur=true
corner-radius=0
force-light-text=false
match-theme-in-overview=false
override-background=true
override-background-dynamically=true
override-background-dynamically-mode=1
pipeline='pipeline_liquid_glass'
static-blur=true
style-panel=0
unblur-in-overview=true

[blur-my-shell/popup]
pipeline='pipeline_liquid_glass'

[clipboard-indicator]
enable-keybindings=true
toggle-menu=['<Super>v']

[com/github/hermes83/compiz-windows-effect]
preset='R'

[tilingshell]
cycle-layouts-backward=['<Shift>']
layouts-json='[{"id":"Layout 3","tiles":[{"x":0,"y":0,"width":0.33,"height":1,"groups":[1]},{"x":0.33,"y":0,"width":0.67,"height":1,"groups":[1]}]},{"id":"Layout 4","tiles":[{"x":0,"y":0,"width":0.67,"height":1,"groups":[1]},{"x":0.67,"y":0,"width":0.33,"height":1,"groups":[1]}]},{"id":"2302412","tiles":[{"x":0,"y":0,"width":0.5,"height":1,"groups":[1]},{"x":0.5,"y":0,"width":0.49999999999999994,"height":1,"groups":[1]}]}]'
selected-layouts=[['2302412', '2302412'], ['2302412', '2302412']]
window-use-custom-border-color=false
